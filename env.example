# Скопируйте этот файл в .env и заполните значения. Файл .env не загружайте на GitHub.

# Токен бота от @BotFather
TELEGRAM_TOKEN=

# Ключ авторизации GigaChat API (developers.sber.ru → GigaChat API → Authorization Key)
GIGACHAT_CREDENTIALS=
# GIGACHAT_API_PERS — для физлиц
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Модель с поддержкой изображений
GIGACHAT_MODEL=GigaChat-2-Max
# true, если установлен сертификат НУЦ Минцифры
GIGACHAT_VERIFY_SSL=false

# Распознавание речи из видео (необязательно): Yandex Cloud → сервисный аккаунт → API-ключ
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# Сколько проверок одновременно отправляется в нейросеть (остальные ждут в очереди).
# В бесплатном тарифе GigaChat (Freemium) разрешён 1 поток.
MAX_PARALLEL_CHECKS=1
# Через сколько дней сохранённый результат проверяется заново
CACHE_DAYS=30
DATA_DIR=data

# Этап 2: апелляции
# Через сколько дней удаляются доводы апелляций и подписки на уведомления
RETENTION_DAYS=180
# Сколько апелляций в сутки может подать один пользователь
APPEALS_PER_DAY=5
